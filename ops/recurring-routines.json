{
  "site": "outsourcepayrollcompany.com",
  "repository": "coolifystealthagents/outsourcepayrollcompany",
  "branch": "main",
  "timezone": "UTC",
  "completionBoundary": "github_push",
  "coolifyDeploymentInRoutine": false,
  "routines": [
    {
      "id": "daily-blog-publishing",
      "title": "Daily Blog Publishing",
      "cron": "0 9 * * 1-5",
      "concurrency": "skip_if_active",
      "catchUp": "skip_missed",
      "priority": "medium",
      "target": "random inclusive integer 20..25",
      "runbook": "Research, de-duplicate, brief, draft, validate, run official blader/humanizer, revalidate, generate deterministic thumbnail, update blog indexes/sitemap inputs, build, commit, push, record SHA/branch/files/result, then stop."
    },
    {
      "id": "daily-research-publishing",
      "title": "Daily Research Publishing",
      "cron": "0 6 * * *",
      "concurrency": "always_enqueue",
      "catchUp": "skip_missed",
      "priority": "high",
      "target": "random inclusive integer 10..15",
      "runbook": "Research at least 10 real sources, de-duplicate, brief, draft, validate, run official blader/humanizer, revalidate, generate deterministic thumbnail, update research indexes/clusters/related mappings/sitemap inputs, build, commit, push, record SHA/branch/files/result, then stop."
    },
    {
      "id": "batched-coolify-deployment",
      "title": "Batched Coolify Deployment",
      "active": true,
      "cron": "0 3,9,15,21 * * *",
      "concurrency": "skip_if_active",
      "catchUp": "skip_missed",
      "priority": "high",
      "assignedTo": ["Chief of Staff"],
      "handoff": "daily_blog_batch_manifest",
      "mapping": {
        "domain": "outsourcepayrollcompany.com",
        "paperclipProject": "Onboarding",
        "repository": "coolifystealthagents/outsourcepayrollcompany",
        "productionBranch": "main",
        "applicationUuidFrom": "COOLIFY_APPLICATION_UUID"
      },
      "pipeline": ["require_all_daily_blog_items_complete_and_validated", "validate_batch_and_build", "commit_all_batch_changes_once", "push_production_branch_once", "reconcile_persisted_sha_and_deployment", "inspect_global_coolify_queue", "trigger_one_exact_application_deployment", "persist_non_secret_deployment_evidence", "verify_successful_deployment_and_live_blog_pages"],
      "allowedOutcomes": ["SKIPPED_INCOMPLETE", "NO_NEW_CHANGES", "ALREADY_DEPLOYED", "DEPLOYMENT_ALREADY_PENDING", "SKIPPED_COOLIFY_QUEUE", "DEPLOYMENT_SUBMITTED", "DEPLOYMENT_IN_PROGRESS", "DEPLOYMENT_FAILED", "LIVE_VERIFIED"],
      "configuration": {"protected": ["COOLIFY_API_URL", "COOLIFY_API_TOKEN", "COOLIFY_APPLICATION_UUID"], "neverPersist": ["COOLIFY_API_TOKEN"]}
    }
  ]
}
